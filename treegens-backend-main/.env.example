# Copy to `.env` — do not commit secrets.

MONGODB_URI=
PINATA_JWT=
PINATA_GATEWAY_BASE_URL=

# --- Mangrove plant video AI verification ---

# ultralytics (default): Bearer + multipart to custom API
# roboflow_workflow: Roboflow Serverless workflow (see ROBOFLOW_*)
AI_PROVIDER=ultralytics

AI_API_BASE_URL=https://app.buildingculture.capital
AI_API_BEARER_TOKEN=
# Base + path, OR set a full predict URL (e.g. Cloud Run) — wins over BASE+VERIFY_PATH:
# AI_API_PREDICT_URL=https://your-service-xxx.run.app/predict
AI_API_VERIFY_PATH=
AI_VIDEO_FORM_FIELD_NAME=video
# Ultralytics-style predict: optional inference params (same as browser FormData conf/iou/imgsz)
# AI_PREDICT_CONF=0.25
# AI_PREDICT_IOU=0.7
# AI_PREDICT_IMGSZ=640
# Set false if `/predict` rejects extra fields (only file + params are sent)
# AI_API_SEND_SUBMISSION_METADATA=true
AI_REQUEST_TIMEOUT_MS=120000

# Comma-separated dotted paths for count / confidence in JSON responses (optional overrides)
# AI_RESPONSE_COUNT_PATHS=mangrove_count,outputs.mangrove_count,count
# AI_RESPONSE_CONFIDENCE_PATHS=confidence,data.confidence

# --- Roboflow (only when AI_PROVIDER=roboflow_workflow) ---

ROBOFLOW_API_URL=https://serverless.roboflow.com
# Roboflow private key; if empty, AI_API_BEARER_TOKEN is reused when set
ROBOFLOW_API_KEY=

# Provide exactly one routing option (UI snippet often shows the full POST URL):

# Full POST URL override (same as Roboflow “copy URL”)
# ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/zeroxleonardos-workspace/workflows/mangrove-planting-proof-verifier-1777557655867

# Or workspace + deployed workflow id (equivalent URL)
# ROBOFLOW_WORKSPACE_NAME=zeroxleonardos-workspace
# ROBOFLOW_WORKFLOW_ID=mangrove-planting-proof-verifier-1777557655867

# Or inline specification file for https://serverless.roboflow.com/workflows/run
# ROBOFLOW_WORKFLOW_SPEC_PATH=/absolute/or/relative/path/workflow-spec.json

AI_ROBOFLOW_CONFIDENCE=0.96
AI_ROBOFLOW_IMAGE_FIELD=image

# Match minimal browser JSON: only api_key + inputs.image (set all three)
# AI_ROBOFLOW_SEND_CONFIDENCE=false
# AI_ROBOFLOW_SEND_VIDEOMETA=false
# AI_ROBOFLOW_MINIMAL_REQUEST=true

# Server default: middle-frame JPEG as inputs.image { type: "base64", value }.
# Optional: pass verifyMangrovePlantVideo({ workflowImageUrl }) for { type: "url", value } instead.

# Optional extra JSON merged into workflow inputs as `videometa`
# AI_ROBOFLOW_VIDEOMETA_JSON={"note":"submission metadata"}

# Set to false if the workflow has no WorkflowVideoMetadata input
# AI_ROBOFLOW_SEND_VIDEOMETA=true
