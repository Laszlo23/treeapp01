# Copy to `.env.local` for local dev (never commit secrets).

# =============================================================================
# Thirdweb + WalletConnect (required for production-quality wallet UX)
# =============================================================================
# Client ID — https://portal.thirdweb.com/typescript/v5/client
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# WalletConnect Cloud Project ID — https://cloud.walletconnect.com/
# Used by `useConnectModal` + WalletConnect-enabled wallets (QR / mobile).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional absolute site URL for app metadata when `window` is unavailable (SSR / OG).
# NEXT_PUBLIC_APP_URL=https://treegens.app

# =============================================================================
# TreeGens backend API (`axiosInstance`, offline queue absolute URLs)
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:5001

# =============================================================================
# Base mainnet — TGN stake / token (must match backend `TGN_*` for same deployment)
# Defaults in code match production TreeGens Base deploy; override when needed.
# NEXT_PUBLIC_TGN_VAULT_ADDRESS=0x64b05503c6F2233d279E6B8B8f2Da6936dEd584C
# NEXT_PUBLIC_TGN_TOKEN_ADDRESS=0xD75dfa972C6136f1c594Fec1945302f885E1ab29
# NEXT_PUBLIC_TGN_TOKEN_DECIMALS=18
# NEXT_PUBLIC_VALIDATORS_MINIMUM_TGN_TOKENS=2000

# =============================================================================
# IPFS / media
# =============================================================================
# Prefix for `ipfs://` / CID resolution — https://portal.thirdweb.com/storage
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# =============================================================================
# Auth UI
# =============================================================================
# Sign-in background: optional full URL; otherwise `/img/treegens-bg.png` or a default image.
# NEXT_PUBLIC_AUTH_BG_URL=

# =============================================================================
# Push + inbox (optional)
# =============================================================================
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_NOTIF_STREAM_URL=

# =============================================================================
# Feature flags
# =============================================================================
# NEXT_PUBLIC_ONCHAIN_DELEGATE_ENABLED=false

# =============================================================================
# Social quests + footer links (defaults match production TreeGens URLs)
# =============================================================================
# NEXT_PUBLIC_X_TREEGENS_PROFILE_URL=https://x.com/treegens
# NEXT_PUBLIC_X_JIMI_PROFILE_URL=https://x.com/JimiCohen
# NEXT_PUBLIC_X_CAMPAIGN_POST_URL=https://x.com/JimiCohen/status/1830892593603035487
# NEXT_PUBLIC_TELEGRAM_TREEGEN_FAM_URL=https://t.me/TreegenFam
# NEXT_PUBLIC_UNISWAP_ADD_LIQUIDITY_URL=https://app.uniswap.org/
# NEXT_PUBLIC_SOCIAL_SHARE_MINIAPP_URL=https://treegens.app
# NEXT_PUBLIC_POINTS_PER_TGN_HINT=100
# NEXT_PUBLIC_SUPPORT_URL=mailto:support@treegens.app
# NEXT_PUBLIC_DOCS_URL=https://treegens.app
