# Copy to .env — do not commit secrets.

POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=treegens_planting

JWT_SECRET=change-me-please-32char-minimum-xxx
INTERNAL_API_KEY=internal-dev-key

# YOLO weights — mount to /models/best.pt in container
MODEL_PATH=/models/best.pt
MODEL_VERSION=yolo11-obb-v1

# Inference tuning (validated on WhatsApp 40-tree + MOV_0847 ~101-tree clips)
VIDEO_SAMPLE_FRAMES=48
VIDEO_SAMPLE_INTERVAL_SECONDS=0.5
DEDUPE_CENTER_DISTANCE=0.079
SHORT_CLIP_MAX_DURATION_SECONDS=10
SHORT_CLIP_DEDUPE_CENTER_DISTANCE=0.11
MIN_TREE_CONFIDENCE=0.24
YOLO_IMGSZ=960
YOLO_PREDICT_CONF=0.01

VIDEO_MAX_DURATION_SECONDS=120
MAX_VIDEO_BYTES=104857600
MAX_UPLOAD_BYTES=104857600

CLAIM_COUNT_MAX_DELTA=2
